.gcloudignore
.git
.gitignore

# Never upload node_modules to Cloud Build (Cloud Build must run npm ci in its own Linux container)
node_modules/
**/node_modules/

# Local cache files
.signals_cache.json
.settings_cache.json
.metaapi/
**/.historical_data/backtest_runs/
*.log

# Env
.env
.env.*
!.env.example
