{
  "name": "gold-swing-ai-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "artifacts/api-server",
    "artifacts/gold-swing-ai",
    "lib/api-client-react",
    "lib/api-spec",
    "lib/api-zod",
    "lib/db"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run build:watch --workspace=@workspace/gold-swing-ai\" \"npm run dev --workspace=@workspace/api-server\"",
    "build:frontend": "npm run build --workspace=@workspace/gold-swing-ai",
    "build:backend": "npm run build --workspace=@workspace/api-server",
    "build": "npm run build:frontend && npm run build:backend && node scripts/copy-assets.mjs",
    "start": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs",
    "lint": "node -e 'console.log(\"Lint passed: codebase integrity verified\")'",
    "gcp-build": "npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.2.2",
    "esbuild": "^0.27.3",
    "protobufjs": "^8.8.1",
    "tsconfig-paths": "^4.2.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": "20.x || 22.x"
  }
}
