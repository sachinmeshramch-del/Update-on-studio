{
  "name": "gold-swing-ai-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "artifacts/api-server",
    "artifacts/gold-swing-ai",
    "lib/api-client-react",
    "lib/api-spec",
    "lib/api-zod",
    "lib/db"
  ],
  "scripts": {
    "dev": "concurrently \"npm run build:watch --workspace=@workspace/gold-swing-ai\" \"npm run dev --workspace=@workspace/api-server\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@workspace/api-server"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
