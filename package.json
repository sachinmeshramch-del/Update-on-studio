{
  "name": "gold-swing-ai-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "artifacts/api-server",
    "artifacts/gold-swing-ai",
    "lib/api-client-react",
    "lib/api-spec",
    "lib/api-zod",
    "lib/db"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run build:watch --workspace=@workspace/gold-swing-ai\" \"npm run dev --workspace=@workspace/api-server\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@workspace/api-server",
    "gcp-build": "NODE_OPTIONS=--max-old-space-size=4096 npm run build"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
